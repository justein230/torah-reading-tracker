      "definition": "\n  SELECT\n    r.id          AS reading_id,\n    r.date_read,\n    r.reading_type,\n    r.occasion,\n    r.location,\n    r.created_at,\n    a.aliyah_id,\n    a.sefer,\n    a.sefer_en,\n    a.sefer_color,\n    a.parsha,\n    a.parsha_en,\n    a.aliyah,\n    a.pair_name,\n    a.pseukim,\n    a.pct\n  FROM readings r\n  JOIN v_aliyot a ON a.aliyah_id = r.aliyah_id\n",
