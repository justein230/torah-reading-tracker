# Copy to docker-compose.override.yml and fill in your deployment values.
# This file is merged automatically over docker-compose.yml on `docker compose up`.
# docker-compose.override.yml is gitignored — keep real infra values there only.
#
# This variant is for a direct deployment (no reverse proxy in front): the app's
# own password login handles auth, and its port is exposed on the host. If you're
# putting a reverse proxy in front that will authenticate every request, copy
# docker-compose.override.yml.header-example instead.
services:
  torah:
    # Pull a prebuilt image from your registry instead of building locally:
    # image: registry.example.com/you/torah:latest

    # IP-based access restriction (if you want it) belongs in your reverse proxy
    # (e.g. Traefik's ipallowlist middleware) in front of this service, not here.

    # Expose the port for the Torah app. Both sides come from .env.
    # ports:
    #   - "127.0.0.1:${TORAH_HOST_PORT:-3000}:${PORT:-3000}"

    # Bind-mount a host directory for the SQLite data instead of a named volume.
    # The container path (right of the colon) must stay /data.
    # volumes:
    #   - /var/lib/torah:/data
