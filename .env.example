# Server
PORT=3000
TORAH_HOST=127.0.0.1
TORAH_DB_PATH=./torah.db

# Docker reads the vars in this file, except TORAH_DB_PATH — the container's DB
# path is pinned to the /data volume in docker-compose.yml.
# Host port published for the container (container side uses PORT above).
# TORAH_HOST_PORT=3000
# The image sets NODE_ENV=production, where the session cookie is Secure and
# login needs HTTPS. Use development only for a plain-HTTP test box.
# NODE_ENV=production

# ── write-access auth ─────────────────────────────────────────────────────────
# TORAH_AUTH_MODE selects how writes are gated:
#   password (default) — the app's own login, and nothing else. Write access is
#                         purely "is there a valid session", so there's no
#                         ambiguity about whether you're actually logged in. See below.
#   header              — trust a header an upstream reverse proxy sets after doing
#                          its own auth (Traefik/Caddy basicAuth, Authelia,
#                          oauth2-proxy, Tailscale Serve, Cloudflare Access, etc.).
#                          The header is only trusted when TORAH_REQUIRE_PROXY_HEADER=true,
#                          since otherwise a client could set it themselves. Every router
#                          in front of the app must either set this header (after
#                          authenticating) or blank it, or anyone can grant themselves
#                          access. Any IP-based restriction (e.g. LAN-only access)
#                          belongs in the reverse proxy in front of the app, not here.
# TORAH_AUTH_MODE=header
# TORAH_AUTH_HEADER=X-Forwarded-User

# password mode: set TORAH_ADMIN_PASSWORD (plaintext) once and start the app — it
# hashes the password and stores the hash in the database, so the plaintext env var
# doesn't need to stay set. Remove it after the first successful start; the app
# shows a banner if it's still set once a hash already exists, since a leaked
# plaintext env var is far more damaging than a leaked hash.
#
# If you skip this entirely, the app generates a random one-time password on first
# start and prints it to the logs (same pattern as Rancher/NetBox) — log in with it
# and change it from Settings.
# TORAH_ADMIN_PASSWORD=change-me-to-something-long-and-random

# Only honor TORAH_AUTH_HEADER when it's set by a proxy, never trust it from a
# direct client. Defaults to on in production. Required for header mode.
# TORAH_REQUIRE_PROXY_HEADER=true

# Vite dev server host and port
VITE_HOST=127.0.0.1
VITE_DEV_PORT=8000

# Express API port (proxied by Vite in dev)
VITE_API_PORT=3000

# Optional: comma-separated extra hostnames allowed by the Vite dev server.
# Add your machine's hostname here if accessing from another device on LAN.
# Machine-specific values belong in .env.local (gitignored by Vite automatically).
# VITE_ALLOWED_HOSTS=mybox.local,myworkstation.corp.example.com
