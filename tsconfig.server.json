{
  "compilerOptions": {
    "target":                  "ES2020",
    "lib":                     ["ES2020", "DOM"],
    "module":                  "NodeNext",
    "moduleResolution":        "NodeNext",
    "strict":                  true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop":         true,
    "allowSyntheticDefaultImports": true,
    "allowJs":                 true,
    "skipLibCheck":            true,
    "outDir":                  "dist-server",
    "rootDir":                 "."
  },
  "include": ["server.ts"]
}
